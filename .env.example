# LangSmith Configuration
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Necessário apenas se sua API key for um Personal Access Token de escopo
# organizacional (multi-workspace). Sem isso, chamadas a /datasets, /commits
# (prompt hub) e /sessions retornam 403 Forbidden mesmo com a key correta.
# Descubra o ID em https://smith.langchain.com/settings (ou via API: GET /workspaces).
LANGSMITH_WORKSPACE_ID=

# Publique um prompt no langsmith hub para gerar seu username, depois abra o prompt e vá no simbolo de cadeado.
USERNAME_LANGSMITH_HUB=

# OpenAI Configuration
OPENAI_API_KEY=

# Google Gemini Configuration
GOOGLE_API_KEY=

# LLM Configuration
# Nota: modelos "gemini-2.5-*" podem não estar mais disponíveis para contas
# novas do Google AI Studio (a API retorna 404 pedindo para usar uma versão
# mais recente). Se isso acontecer, liste os modelos disponíveis para sua
# key (GET https://generativelanguage.googleapis.com/v1beta/models?key=SUA_KEY)
# e ajuste os valores abaixo.
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
EVAL_MODEL=gemini-2.5-flash

#LLM_PROVIDER=openai
#LLM_MODEL=gpt-4o-mini
#EVAL_MODEL=gpt-4o

# Opcional: pausa (segundos) entre chamadas de LLM em src/evaluate.py, para
# respeitar a cota do tier gratuito (padrão: 4.5s, ok para ~15 req/min). Com
# billing ativo na conta do Google, pode reduzir (ex: 0.5) para acelerar.
#EVAL_CALL_DELAY_SECONDS=4.5